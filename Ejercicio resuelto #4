class Edades:
    def __init__(self, edad_juan):
        self.edad_juan = edad_juan
        self.edad_alberto = int(2/3 * edad_juan)
        self.edad_ana = int(4/3 * edad_juan)
        self.edad_mama = self.edad_juan + self.edad_alberto + self.edad_ana

    def mostrar(self):
        print(f"Juan: {self.edad_juan}, Alberto: {self.edad_alberto}, Ana: {self.edad_ana}, Mamá: {self.edad_mama}")


edad = int(input("Ingrese la edad de Juan: "))
f = Edades(edad)
f.mostrar()
