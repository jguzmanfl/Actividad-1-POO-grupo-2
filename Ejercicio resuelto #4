Edad_de_Juan=int(input("Ingrese la edad de Juan: " ))
Edad_de_Alberto=int(2/3 * Edad_de_Juan)
Edad_de_Ana= int(Edad_de_Juan * 4/3)
Edad_de_Mama= int(Edad_de_Juan + Edad_de_Alberto + Edad_de_Ana)
print(f"La edad de cada uno es: Juan {Edad_de_Juan}, Alberto {Edad_de_Alberto}, Ana {Edad_de_Ana}, Mamá {Edad_de_Mama}")
