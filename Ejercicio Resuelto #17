import math

class Circulo:
    def __init__(self, radio):
        self.radio = radio

    def calcular(self):
        area = math.pi * self.radio ** 2
        diametro = 2 * self.radio
        longitud = math.pi * diametro
        return area, longitud


radio = float(input("Ingrese el radio del círculo: "))
c = Circulo(radio)

area, longitud = c.calcular()
print(f"Área: {area:.2f}, Longitud de la circunferencia: {longitud:.2f}")
